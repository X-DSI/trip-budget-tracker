# Used by `vite --mode e2e` and the Playwright tests: a demo project that only exists in the
# local emulators. Never points at the live project.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-trip-budget
VITE_FIREBASE_STORAGE_BUCKET=demo-trip-budget.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_USE_EMULATORS=true
