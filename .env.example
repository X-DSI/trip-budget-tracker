# Copy to .env.local for local development against the real project.
# Firebase web config is public by design; it lives in env vars so previews and live can differ.
VITE_FIREBASE_API_KEY=
# Use the Hosting domain (not *.firebaseapp.com) so sign-in redirects work with
# browsers' third-party storage partitioning.
VITE_FIREBASE_AUTH_DOMAIN=x-dsi-trip-budget.web.app
VITE_FIREBASE_PROJECT_ID=x-dsi-trip-budget
VITE_FIREBASE_STORAGE_BUCKET=x-dsi-trip-budget.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=false
