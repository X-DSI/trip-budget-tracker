rules_version = '2';

// Security rules for trip-budget-tracker. The access table lives in docs/data-model.md.
// Trip-scoped permissions come from the trip document's `memberUids` and `organizerUids`.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    function tripBefore(tripId) {
      return get(tripPath(tripId)).data;
    }

    function tripAfter(tripId) {
      return getAfter(tripPath(tripId)).data;
    }

    function isMember(tripId) {
      return signedIn() && exists(tripPath(tripId)) && me() in tripBefore(tripId).memberUids;
    }

    function isOrganizer(tripId) {
      return signedIn() && exists(tripPath(tripId)) && me() in tripBefore(tripId).organizerUids;
    }

    // Member after this batch (covers a family created in the same batch as joining).
    function isMemberAfter(tripId) {
      return signedIn() && me() in tripAfter(tripId).memberUids;
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isOptionalDate(v) {
      return v == null || isDate(v);
    }

    function isText(v, max) {
      return v is string && v.size() <= max;
    }

    function isRequiredText(v, max) {
      return isText(v, max) && v.size() > 0;
    }

    function isOptionalInt(v, max) {
      return v == null || (v is int && v >= 0 && v <= max);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function validInvite(code, tripId) {
      let path = /databases/$(database)/documents/invites/$(code);
      return code is string && exists(path)
        && get(path).data.tripId == tripId && get(path).data.active == true;
    }

    // ---------- users ----------

    match /users/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(
             ['displayName', 'photoURL', 'activeTripId', 'createdAt', 'updatedAt']);
      allow delete: if false;
    }

    // ---------- invites (document ID is the code) ----------

    match /invites/{code} {
      // A preview of the trip, so the join page can show what you're joining. It must match the
      // trip as it will be after this write, so nobody can forge it.
      function previewKeys() {
        return ['tripName', 'tripStartDate', 'tripEndDate', 'tripDestination', 'ownerName'];
      }

      function previewMatchesTrip(d) {
        let t = tripAfter(d.tripId);
        return d.tripName == t.name
          && d.tripStartDate == t.startDate
          && d.tripEndDate == t.endDate
          && d.tripDestination == t.get('destination', '')
          && d.ownerName == getAfter(
               /databases/$(database)/documents/trips/$(d.tripId)/members/$(t.ownerUid))
               .data.get('displayName', '');
      }

      // Knowing the code is what grants access; nobody can browse other trips' invites.
      allow get: if signedIn();
      allow list: if isOrganizer(resource.data.tripId);
      allow create: if isOrganizer(request.resource.data.tripId)
        && code.size() >= 22
        && request.resource.data.keys().hasOnly(
             ['tripId', 'active', 'createdBy', 'createdAt'].concat(previewKeys()))
        && request.resource.data.keys().hasAll(previewKeys())
        && request.resource.data.active == true
        && request.resource.data.createdBy == me()
        && previewMatchesTrip(request.resource.data);
      // Organisers turn invites on or off, and refresh the preview when the trip changes.
      allow update: if isOrganizer(resource.data.tripId)
        && changedOnly(['active'].concat(previewKeys()))
        && request.resource.data.active is bool
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(previewKeys())
            || previewMatchesTrip(request.resource.data));
      allow delete: if false;
    }

    // ---------- trips ----------

    match /trips/{tripId} {

      function validTrip(d) {
        return d.keys().hasOnly([
            'name', 'destination', 'startDate', 'endDate', 'timezone', 'expectedKm', 'kidWeight',
            'currency', 'ownerUid', 'memberUids', 'organizerUids', 'notes', 'importantInfo',
            'createdAt', 'updatedAt'])
          && d.keys().hasAll(['name', 'startDate', 'endDate', 'ownerUid', 'memberUids',
            'organizerUids'])
          && isRequiredText(d.name, 100)
          && isText(d.get('destination', ''), 200)
          && isDate(d.startDate) && isDate(d.endDate) && d.endDate >= d.startDate
          && d.get('timezone', 'Asia/Kolkata') is string
          && isOptionalInt(d.get('expectedKm', null), 100000)
          && d.get('kidWeight', 0.5) is number
          && d.get('kidWeight', 0.5) >= 0 && d.get('kidWeight', 0.5) <= 1
          && d.get('currency', 'INR') == 'INR'
          && isText(d.get('notes', ''), 2000)
          && isText(d.get('importantInfo', ''), 4000)
          && d.memberUids is list && d.organizerUids is list
          && d.ownerUid in d.organizerUids
          && d.memberUids.toSet().hasAll(d.organizerUids);
      }

      allow read: if signedIn() && me() in resource.data.memberUids;

      // The creator is the owner, the only member and the only organiser.
      allow create: if signedIn()
        && validTrip(request.resource.data)
        && request.resource.data.ownerUid == me()
        && request.resource.data.memberUids == [me()]
        && request.resource.data.organizerUids == [me()];

      // Organisers edit details and roles, but never membership or ownership.
      // Joining: someone with a valid invite adds only themselves to memberUids, in the same
      // batch that creates their members/{uid} document (which names the invite).
      allow update: if validTrip(request.resource.data) && (
          (isOrganizer(tripId)
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.memberUids == resource.data.memberUids)
          ||
          (signedIn()
            && !(me() in resource.data.memberUids)
            && changedOnly(['memberUids'])
            && request.resource.data.memberUids.toSet()
                 == resource.data.memberUids.toSet().union([me()].toSet())
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
            && validInvite(
                 getAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(me()))
                   .data.joinedVia,
                 tripId))
        );

      allow delete: if false;

      // ---------- itinerary: the day-by-day plan (docs/adr/2026-11-24-itinerary-replaces-legs.md)

      match /itinerary/{itemId} {
        function validItem(d) {
          let t = tripBefore(tripId);
          return d.keys().hasOnly(['day', 'time', 'kind', 'title', 'place', 'notes', 'mode',
              'vehicles', 'km', 'order', 'createdAt', 'updatedAt'])
            && isDate(d.day) && d.day >= t.startDate && d.day <= t.endDate
            && (d.get('time', null) == null
                || (d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
            && d.kind in ['travel', 'sightseeing', 'food', 'stay', 'activity', 'other']
            && isRequiredText(d.title, 100)
            && isText(d.get('place', ''), 200)
            && isText(d.get('notes', ''), 500)
            && d.order is int
            && (d.kind == 'travel'
                ? (d.get('mode', null) in ['car', 'bus', 'train', 'flight', 'other']
                    && d.get('vehicles', 1) is int
                    && d.get('vehicles', 1) >= 1 && d.get('vehicles', 1) <= 50
                    && isOptionalInt(d.get('km', null), 20000))
                : (d.get('mode', null) == null && d.get('vehicles', null) == null
                    && d.get('km', null) == null));
        }

        allow read: if isMember(tripId);
        allow create, update: if isOrganizer(tripId) && validItem(request.resource.data);
        allow delete: if isOrganizer(tripId);
      }

      // ---------- families ----------

      match /families/{familyId} {
        function validFamily(d) {
          return d.keys().hasOnly(['name', 'adults', 'kids', 'upiId', 'color', 'order', 'active',
              'createdBy', 'createdAt', 'updatedAt'])
            && isRequiredText(d.name, 60)
            && d.adults is int && d.adults >= 1 && d.adults <= 20
            && d.kids is int && d.kids >= 0 && d.kids <= 20
            && (d.get('upiId', null) == null || isText(d.upiId, 100))
            && isText(d.get('color', ''), 20)
            && d.order is int
            && d.active is bool;
        }

        allow read: if isMember(tripId);
        // Organisers add families; a person joining may add their own family in the join batch.
        allow create: if (isOrganizer(tripId) || isMemberAfter(tripId))
          && validFamily(request.resource.data);
        allow update: if isOrganizer(tripId) && validFamily(request.resource.data);
        allow delete: if false;
      }

      // ---------- expenses (docs/adr/2026-11-24-who-can-change-money.md) ----------

      match /expenses/{expenseId} {
        function validExpense(d) {
          return d.keys().hasOnly(['title', 'category', 'amountPaise', 'paidByFamilyId', 'date',
              'splitMode', 'participants', 'items', 'extrasPaise', 'customShares', 'note',
              'deleted', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
            && isRequiredText(d.title, 100)
            && d.category in ['fuel', 'tolls', 'food', 'stay', 'tickets', 'shopping',
                 'transport', 'other']
            && d.amountPaise is int && d.amountPaise > 0 && d.amountPaise <= 1000000000
            && d.paidByFamilyId is string
            && exists(/databases/$(database)/documents/trips/$(tripId)/families/$(d.paidByFamilyId))
            && isDate(d.date)
            && d.splitMode in ['equal_family', 'per_head', 'itemized', 'custom', 'personal']
            && d.get('participants', []) is list && d.get('participants', []).size() <= 50
            && d.get('items', []) is list && d.get('items', []).size() <= 100
            && d.get('extrasPaise', 0) is int && d.get('extrasPaise', 0) >= 0
            && d.get('customShares', {}) is map
            && isText(d.get('note', ''), 500)
            && d.deleted is bool
            && d.updatedBy == me();
        }

        allow read: if isMember(tripId);
        allow create: if isMember(tripId)
          && validExpense(request.resource.data)
          && request.resource.data.createdBy == me()
          && request.resource.data.deleted == false;
        // The person who added it, or an organiser, may edit or (soft) delete it.
        allow update: if isMember(tripId)
          && (resource.data.createdBy == me() || isOrganizer(tripId))
          && validExpense(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if false;
      }

      // ---------- budget: the plan (docs/adr/2026-11-24-who-can-change-money.md) ----------

      match /budget/{lineId} {
        function validBudgetLine(d) {
          return d.keys().hasOnly(['category', 'title', 'amountPaise', 'splitMode',
              'participants', 'customShares', 'familyId', 'order', 'createdBy', 'updatedBy',
              'createdAt', 'updatedAt'])
            && d.category in ['fuel', 'tolls', 'food', 'stay', 'tickets', 'shopping',
                 'transport', 'other']
            && isRequiredText(d.title, 100)
            && d.amountPaise is int && d.amountPaise > 0 && d.amountPaise <= 1000000000
            && d.splitMode in ['equal_family', 'per_head', 'custom', 'personal']
            && d.get('participants', []) is list && d.get('participants', []).size() <= 50
            && d.get('customShares', {}) is map
            && (d.splitMode != 'personal' || (d.get('familyId', null) is string
                 && exists(/databases/$(database)/documents/trips/$(tripId)/families/$(d.familyId))))
            && (d.get('familyId', null) == null || d.familyId is string)
            && d.order is int
            && d.updatedBy == me();
        }

        allow read: if isMember(tripId);
        allow create: if isOrganizer(tripId)
          && validBudgetLine(request.resource.data)
          && request.resource.data.createdBy == me();
        allow update: if isOrganizer(tripId)
          && validBudgetLine(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy;
        // A plan needs no history, so lines are deleted outright.
        allow delete: if isOrganizer(tripId);
      }

      // ---------- settlements: payments between families ----------

      match /settlements/{settlementId} {
        function familyExists(familyId) {
          return familyId is string
            && exists(/databases/$(database)/documents/trips/$(tripId)/families/$(familyId));
        }

        // The family the signed-in adult picked on this trip, or null.
        function myFamily() {
          let path = /databases/$(database)/documents/trips/$(tripId)/members/$(me());
          return exists(path) ? get(path).data.get('familyId', null) : null;
        }

        function validSettlement(d) {
          return d.keys().hasOnly(['fromFamilyId', 'toFamilyId', 'amountPaise', 'date', 'method',
              'note', 'deleted', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
            && familyExists(d.fromFamilyId) && familyExists(d.toFamilyId)
            && d.fromFamilyId != d.toFamilyId
            && d.amountPaise is int && d.amountPaise > 0 && d.amountPaise <= 1000000000
            && isDate(d.date)
            && d.method in ['upi', 'cash', 'other']
            && isText(d.get('note', ''), 200)
            && d.deleted is bool
            && d.updatedBy == me();
        }

        allow read: if isMember(tripId);
        // Only an adult of the paying or receiving family records a payment, as themselves.
        allow create: if isMember(tripId)
          && validSettlement(request.resource.data)
          && myFamily() != null
          && myFamily() in [request.resource.data.fromFamilyId, request.resource.data.toFamilyId]
          && request.resource.data.createdBy == me()
          && request.resource.data.deleted == false;
        // A recorded payment is never edited, only (soft) deleted or restored, by the person who
        // recorded it or an organiser. To fix an amount, delete it and record it again.
        allow update: if isMember(tripId)
          && (resource.data.createdBy == me() || isOrganizer(tripId))
          && changedOnly(['deleted', 'updatedBy', 'updatedAt'])
          && validSettlement(request.resource.data);
        allow delete: if false;
      }

      // ---------- members (document ID is the user's uid) ----------

      match /members/{memberUid} {
        function validMember(d) {
          return d.keys().hasOnly(['displayName', 'photoURL', 'familyId', 'role', 'joinedVia',
              'joinedAt'])
            && isText(d.get('displayName', ''), 100)
            && d.role in ['owner', 'organizer', 'member'];
        }

        function familyOk(familyId) {
          return familyId == null || existsAfter(
            /databases/$(database)/documents/trips/$(tripId)/families/$(familyId));
        }

        allow read: if isMember(tripId);

        allow create: if signedIn() && me() == memberUid
          && validMember(request.resource.data)
          && familyOk(request.resource.data.get('familyId', null))
          && (
            // The owner, in the batch that creates the trip.
            (request.resource.data.role == 'owner'
              && !exists(tripPath(tripId))
              && tripAfter(tripId).ownerUid == me())
            ||
            // Anyone joining with a valid invite, in the batch that adds them to memberUids.
            (request.resource.data.role == 'member'
              && validInvite(request.resource.data.joinedVia, tripId)
              && me() in tripAfter(tripId).memberUids)
          );

        allow update: if validMember(request.resource.data) && (
            // Members manage their own profile and family, never their role.
            (signedIn() && me() == memberUid
              && isMember(tripId)
              && changedOnly(['familyId', 'displayName', 'photoURL'])
              && familyOk(request.resource.data.get('familyId', null)))
            ||
            // Organisers change other people's roles, keeping the trip's organizerUids in step.
            (isOrganizer(tripId)
              && me() != memberUid
              && changedOnly(['role'])
              && resource.data.role != 'owner'
              && request.resource.data.role in ['organizer', 'member']
              && ((request.resource.data.role == 'organizer')
                    == (memberUid in tripAfter(tripId).organizerUids)))
          );

        allow delete: if false;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
